PORT=8080
TRACCAR_URL=http://traccar:8082
TRACCAR_TOKEN=CHANGE_ME
ENGINE_STOP_MAX_SPEED_KMH=20
MAP_PROVIDER=auto
GOOGLE_MAPS_API_KEY=
BALAD_API_KEY=
NESHAN_API_KEY=
TOPUP_PROVIDER=disabled
TOPUP_API_URL=
TOPUP_API_KEY=
DATABASE_URL=postgresql://mtcar:CHANGE_ME@postgres:5432/mtcar
JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=30d

# Annual membership fee is controlled by the server, not the APK.
SUBSCRIPTION_ANNUAL_PRICE_TOMAN=1200000
SUBSCRIPTION_GRACE_DAYS=3

# Payment provider adapter.
PAYMENT_PROVIDER=disabled
PAYMENT_API_URL=
PAYMENT_VERIFY_URL=
PAYMENT_API_KEY=
PAYMENT_CALLBACK_URL=https://api.mediatelecom.ir/api/subscription/payment/callback

# SMS OTP provider for account verification / phone-number changes.
SMS_PROVIDER=disabled
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=

# Create/promote the first admin account manually after initial setup.
# Do not expose admin credentials in the APK.
ADMIN_BOOTSTRAP_PHONE=
# Tracker-SIM status / recharge integration.
# Configure a real provider/API before production use.
SIM_STATUS_PROVIDER=disabled
SIM_STATUS_API_URL=
SIM_STATUS_API_KEY=

SIM_TOPUP_PROVIDER=disabled
SIM_TOPUP_API_URL=
SIM_TOPUP_API_KEY=
SIM_PACKAGES_API_URL=

# Internal Traccar -> MTcar event hook
INTERNAL_EVENT_TOKEN=change-me-to-a-long-random-secret

# Public static IP or DNS name sent to GPS trackers
TRACKER_PUBLIC_HOST=
